# InsForge project URL and anon key — required.
# Get these from your own InsForge project (https://insforge.dev), or via
# the InsForge CLI once linked: `npx @insforge/cli current`
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Optional — your PayPal.me link (e.g. https://paypal.me/yourhandle).
# Leave unset to run checkout in demo mode (a "Simulate Payment" button
# replaces the real PayPal redirect).
NEXT_PUBLIC_PAYPAL_ME_URL=
